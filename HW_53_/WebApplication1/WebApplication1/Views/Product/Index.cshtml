@model List<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<a asp-action="Create" asp-controller="Product" class="btn btn-primary">
    Create new product
</a>

<a asp-action="Index" asp-controller="Order" class="btn btn-secondary">
    Orders
</a>

<br />
<br />

<form asp-action="Index" asp-controller="Product" method="get" class="row g-3">
    <div class="col-md-4">
        <label>Name</label>
        <input type="text" name="name" value="@ViewBag.Name" class="form-control" />
    </div>

    <div class="col-md-4">
        <label>Category</label>
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">All categories</option>
        </select>
    </div>

    <div class="col-md-4">
        <label>Brand</label>
        <select name="brandId" asp-items="ViewBag.Brands" class="form-control">
            <option value="">All brands</option>
        </select>
    </div>

    <div class="col-md-3">
        <label>Created from</label>
        <input type="date" name="createdFrom" value="@ViewBag.CreatedFrom" class="form-control" />
    </div>

    <div class="col-md-3">
        <label>Created to</label>
        <input type="date" name="createdTo" value="@ViewBag.CreatedTo" class="form-control" />
    </div>

    <div class="col-md-3">
        <label>Min price</label>
        <input type="number" step="0.01" name="minPrice" value="@ViewBag.MinPrice" class="form-control" />
    </div>

    <div class="col-md-3">
        <label>Max price</label>
        <input type="number" step="0.01" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control" />
    </div>

    <div class="col-md-12">
        <button type="submit" class="btn btn-primary">
            Filter
        </button>

        <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">
            Reset
        </a>
    </div>
</form>

<br />

<div class="mb-3">
    <strong>Sort by:</strong>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewBag.NameSort"
       asp-route-name="@ViewBag.Name"
       asp-route-categoryId="@ViewBag.CategoryId"
       asp-route-brandId="@ViewBag.BrandId"
       asp-route-createdFrom="@ViewBag.CreatedFrom"
       asp-route-createdTo="@ViewBag.CreatedTo"
       asp-route-minPrice="@ViewBag.MinPrice"
       asp-route-maxPrice="@ViewBag.MaxPrice"
       class="btn btn-outline-secondary btn-sm">
        Name
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewBag.BrandSort"
       asp-route-name="@ViewBag.Name"
       asp-route-categoryId="@ViewBag.CategoryId"
       asp-route-brandId="@ViewBag.BrandId"
       asp-route-createdFrom="@ViewBag.CreatedFrom"
       asp-route-createdTo="@ViewBag.CreatedTo"
       asp-route-minPrice="@ViewBag.MinPrice"
       asp-route-maxPrice="@ViewBag.MaxPrice"
       class="btn btn-outline-secondary btn-sm">
        Brand
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewBag.CreatedOnSort"
       asp-route-name="@ViewBag.Name"
       asp-route-categoryId="@ViewBag.CategoryId"
       asp-route-brandId="@ViewBag.BrandId"
       asp-route-createdFrom="@ViewBag.CreatedFrom"
       asp-route-createdTo="@ViewBag.CreatedTo"
       asp-route-minPrice="@ViewBag.MinPrice"
       asp-route-maxPrice="@ViewBag.MaxPrice"
       class="btn btn-outline-secondary btn-sm">
        Created
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewBag.CategorySort"
       asp-route-name="@ViewBag.Name"
       asp-route-categoryId="@ViewBag.CategoryId"
       asp-route-brandId="@ViewBag.BrandId"
       asp-route-createdFrom="@ViewBag.CreatedFrom"
       asp-route-createdTo="@ViewBag.CreatedTo"
       asp-route-minPrice="@ViewBag.MinPrice"
       asp-route-maxPrice="@ViewBag.MaxPrice"
       class="btn btn-outline-secondary btn-sm">
        Category
    </a>

    <a asp-action="Index"
       asp-route-sortOrder="@ViewBag.PriceSort"
       asp-route-name="@ViewBag.Name"
       asp-route-categoryId="@ViewBag.CategoryId"
       asp-route-brandId="@ViewBag.BrandId"
       asp-route-createdFrom="@ViewBag.CreatedFrom"
       asp-route-createdTo="@ViewBag.CreatedTo"
       asp-route-minPrice="@ViewBag.MinPrice"
       asp-route-maxPrice="@ViewBag.MaxPrice"
       class="btn btn-outline-secondary btn-sm">
        Price
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No products found.
    </div>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>

                        <p class="card-text">
                            <b>Brand:</b> @product.Brand?.Name
                        </p>

                        <p class="card-text">
                            <b>Category:</b> @product.Category?.Name
                        </p>

                        <p class="card-text">
                            <b>Price:</b> @product.Price.ToString("0.00")
                        </p>

                        <p class="card-text">
                            <b>Quantity:</b> @product.Quantity
                        </p>

                        <p class="card-text">
                            <b>Added:</b> @product.CreatedOn.ToString("dd.MM.yyyy")
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-primary">
                                Details
                            </a>

                            <a asp-action="Edit" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-secondary">
                                Edit
                            </a>

                            <a asp-action="Create" asp-controller="Order" asp-route-id="@product.Id" class="btn btn-success">
                                Order
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}