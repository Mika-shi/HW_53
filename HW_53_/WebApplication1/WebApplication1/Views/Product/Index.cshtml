@model List<WebApplication1.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<a asp-action="Create" asp-controller="Product" class="btn btn-primary">
    Create new product
</a>

<a asp-action="Index" asp-controller="Order" class="btn btn-secondary">
    Orders
</a>

<br />
<br />

<form asp-action="Index" asp-controller="Product" method="get" class="row g-3">
    <div class="col-md-4">
        <label>Category</label>
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">All categories</option>
        </select>
    </div>

    <div class="col-md-4">
        <label>Brand</label>
        <select name="brandId" asp-items="ViewBag.Brands" class="form-control">
            <option value="">All brands</option>
        </select>
    </div>

    <div class="col-md-4">
        <label>&nbsp;</label>
        <div>
            <button type="submit" class="btn btn-primary">
                Filter
            </button>

            <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">
                Reset
            </a>
        </div>
    </div>
</form>

<br />

@if (Model.Count == 0)
{
    <div class="alert alert-warning">
        No products found.
    </div>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card mb-4">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 250px; object-fit: cover;" />

                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>

                        <p class="card-text">
                            <b>Price:</b> @product.Price
                        </p>

                        <p class="card-text">
                            <b>Added:</b> @product.CreatedOn.ToString("dd.MM.yyyy")
                        </p>

                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-primary">
                                Details
                            </a>
                            <a asp-action="Edit" asp-controller="Product" asp-route-id="@product.Id" class="btn btn-outline-secondary">
                                Edit
                            </a>

                            <a asp-action="Create" asp-controller="Order" asp-route-id="@product.Id" class="btn btn-success">
                                Order
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}