@model List<WebApplication1.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<a asp-action="Create" asp-controller="Category" class="btn btn-primary">Create new category</a>

@if (TempData["Message"] != null)
{
    <div class="alert alert-warning">
        @TempData["Message"]
    </div>
}

@if (Model.Count == 0)
{
    <p>There are no categories yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Products count</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>@category.Products.Count</td>
                <td>
                    <a asp-action="Edit" asp-controller="Category" asp-route-id="@category.Id">
                        Edit
                    </a>
                    |
                    <a asp-action="Delete" asp-controller="Category" asp-route-id="@category.Id"
                       onclick="return confirm('Are you sure you want to delete this category?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}