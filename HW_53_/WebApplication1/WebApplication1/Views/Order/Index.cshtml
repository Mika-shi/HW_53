@model List<WebApplication1.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>
<a asp-action="Index" asp-controller="Product" class="btn btn-secondary">
    Back to products
</a>

<br />
<br />

@if (Model.Count == 0)
{
    <p>There are no orders yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Customer</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Total price</th>
            <th>Status</th>
            <th>Created</th>
        </tr>
        </thead>

        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.Name</td>
                <td>@order.Product.Name</td>
                <td>@order.Quantity</td>
                <td>@order.TotalPrice</td>
                <td>@order.Status</td>
                <td>@order.CreatedOn.ToString("dd.MM.yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}