@model WebApplication1.Models.Order

@{
    ViewData["Title"] = "Create Order";
}

<h1>Create Order</h1>

<form asp-action="Create" asp-controller="Order" method="post">
    <input asp-for="ProductId" type="hidden" />
    
    @if (ViewBag.Message != null)
    {
        <p class="text-danger">@ViewBag.Message</p>
    }
    
    <div class="form-group">
        <label>Product</label>
        <input value="@Model.Product.Name" class="form-control" disabled />
    </div>

    <div class="form-group">
        <label asp-for="Name">Customer name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Address">Address</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="ContactPhone">Contact phone</label>
        <input asp-for="ContactPhone" class="form-control" />
    </div>
    
    <div class="form-group">
        <label asp-for="ContactEmail">Email</label>
        <input asp-for="ContactEmail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="Quantity">Quantity</label>
        <input asp-for="Quantity" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-success">Create order</button>
</form>

<br />

<a asp-action="Details" asp-controller="Product" asp-route-id="@Model.ProductId">
    Back to product
</a>