@model List<WebApplication1.Models.Brand>

@{
    ViewData["Title"] = "Brands";
}

<h1>Brands</h1>

<a asp-action="Create" asp-controller="Brand" class="btn btn-primary">Create new brand</a>

@if (TempData["Message"] != null)
{
    <p class="text-danger">@TempData["Message"]</p>
}

@if (Model.Count == 0)
{
    <p>There are no brands yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Country</th>
            <th>Products count</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        @foreach (var brand in Model)
        {
            <tr>
                <td>@brand.Name</td>
                <td>@brand.Country</td>
                <td>@brand.Products.Count</td>
                    <td>
                        <a asp-action="Edit" asp-controller="Brand" asp-route-id="@brand.Id">
                            Edit
                        </a>
                        |
                        <a asp-action="Delete" asp-controller="Brand" asp-route-id="@brand.Id"
                           onclick="return confirm('Are you sure you want to delete this brand?');">
                            Delete
                        </a>
                    </td>
            </tr>
        }
        </tbody>
    </table>
}