@model WebApplication1.Models.Brand

@{
    ViewData["Title"] = "Create Brand";
}

<h1>Create Brand</h1>

<form asp-action="Create" asp-controller="Brand" method="post">
    <div class="form-group">
        <label asp-for="Name">Brand name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Country">Country</label>
        <input asp-for="Country" class="form-control" />
        <span asp-validation-for="Country" class="text-danger"></span>
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<br />

<a asp-action="Index" asp-controller="Brand">Back to brands</a>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}